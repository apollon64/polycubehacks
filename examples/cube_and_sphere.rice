#use glsl_math
()
{
  cls(0);
  glClear();
  gluPerspective(60, xres/yres, 0.1, 1000.0);
  
  glCullFace(GL_BACK);
  glCullFace(GL_NONE);
  
  glUniform1i("tex0", 0);
  
  global_time = klock();

  glTranslate(0,0,-4);
  if (bstatus) {
     glRotate((mousy/yres-.5)*240,1,0,0);
     glRotate((mousx/xres-.5)*240,0,1,0);
  } else {
     glRotate(global_time*30,0,1,0);
     glRotate(global_time*18,1,0,0);
  }
  glRotate(45,0,1,0);
  glRotate(45,1,0,0);
  
  glColor(1,1,1);
  //cube();
  static int sphere_mesh = 0;
  if (numframes==0) sphere_mesh = createSphere();
  if ( glCheckMesh(sphere_mesh) ) {
       glMesh(sphere_mesh);
  }
}

cube()
{
   glBegin(GL_QUADS);
      glNormal(0,1,0);
      glTexCoord(1.0, 0.0); glVertex( 1.0, 1.0,-1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0, 1.0,-1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0, 1.0, 1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0, 1.0, 1.0);
   
      glNormal(0,-1,0);
      glTexCoord(1.0, 0.0); glVertex( 1.0,-1.0, 1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0,-1.0, 1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0,-1.0,-1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0,-1.0,-1.0);

      glNormal(0,0,1);
      glTexCoord(1.0, 0.0); glVertex( 1.0, 1.0, 1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0, 1.0, 1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0,-1.0, 1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0,-1.0, 1.0);

      glNormal(0,0,-1);
      glTexCoord(1.0, 0.0);  glVertex(1.0,-1.0,-1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0,-1.0,-1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0, 1.0,-1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0, 1.0,-1.0);

      glNormal(-1,0,0);
      glTexCoord(1.0, 0.0); glVertex(-1.0, 1.0, 1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0, 1.0,-1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0,-1.0,-1.0);
      glTexCoord(0.0, 0.0); glVertex(-1.0,-1.0, 1.0);

      glNormal(1,0,0);
      glTexCoord(1.0, 0.0); glVertex( 1.0, 1.0,-1.0);
      glTexCoord(1.0, 1.0); glVertex( 1.0, 1.0, 1.0);
      glTexCoord(0.0, 1.0); glVertex( 1.0,-1.0, 1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0,-1.0,-1.0);
   glEnd();
}

createSphere() { // Returns a mesh_id for glMesh(int mesh_id)

    //enum{sectorCount=18, stackCount=36, vertCount=(sectorCount+1)*(stackCount+1)};
    //enum{sectorCount=9, stackCount=18, vertCount=(sectorCount+1)*(stackCount+1)};
    enum{sectorCount=10, stackCount=12, vertCount=(sectorCount+1)*(stackCount+1)};
    enum{MAX_SPHERE_INDICES=(stackCount*sectorCount-1*sectorCount)*6}
    float radius = 1.5;
    float lengthInv = 1.0 / radius;    // vertex normal

    float sectorStep =  2.0 * pi / float(sectorCount);
    float stackStep  = pi / float(stackCount);
    float sectorAngle = 0;
    float stackAngle = 0;

    static vec3 vertices[vertCount];
    static vec3 normals[vertCount];
    static vec2 texCoords[vertCount];
    num_verts = 0;
    for (i=0; i <= stackCount; i+=1) {
        stackAngle = PI / 2 - float(i) * stackStep;        // starting from pi/2 to -pi/2
        xy = radius * cos(stackAngle);             // r * cos(u)
        z = radius * sin(stackAngle);              // r * sin(u)

        // add (sectorCount+1) vertices per stack
        // the first and last vertices have same position and normal, but different tex coords
        for (j = 0; j <= sectorCount; j+=1) {
            sectorAngle = float(j) * sectorStep;           // starting from 0 to 2pi

            // vertex position (x, y, z)
            x = xy * cos(sectorAngle);             // r * cos(u) * cos(v)
            y = xy * sin(sectorAngle);             // r * cos(u) * sin(v)
            // normalized vertex normal (nx, ny, nz)
            nx = x * lengthInv;
            ny = y * lengthInv;
            nz = z * lengthInv;
            // vertex tex coord (s, t) range between [0, 1]
            float s = float(j) / float(sectorCount);
            float t = float(i) / float(stackCount);
            vertices[num_verts] = vec3(x,y,z);
            normals[num_verts] = vec3(nx,ny,nz);
            texCoords[num_verts] = vec2(s,t);
            num_verts++;
        }
    }
        
    // overestimate amount of indices.
    static int indices[MAX_SPHERE_INDICES];
    //static int lineIndices[stackCount*sectorCount*2];
    num_indices = 0;
    for (i=0; i < stackCount; i+=1) {
        int k1 = i * (sectorCount + 1);
        int k2 = k1 + sectorCount + 1;

        for (j=0; j < sectorCount; j+=1) {
            // 2 triangles per sector excluding first and last stacks
            // k1 => k2 => k1+1
            if (i != 0) {
               indices[num_indices+0] = k1;
               indices[num_indices+1] = k2;
               indices[num_indices+2] = k1+1;
               num_indices+=3;
            }

            // k1+1 => k2 => k2+1
            if (i != (stackCount-1)) {
               indices[num_indices+0] = k1+1;
               indices[num_indices+1] = k2;
               indices[num_indices+2] = k2+1;
               num_indices+=3;
            }

            // store indices for lines
            // vertical lines for all stacks, k1 => k2
            //append(&lineIndices, k1)
            //append(&lineIndices, k2)
            if (i != 0)  // horizontal lines except 1st stack, k1 => k+1
            {
               //lineIndices[num_indices+0] = k1;
               //lineIndices[num_indices+1] = k1+1;
               //num_line_indices+=2;
                //append(&lineIndices, k1)
                //append(&lineIndices, k1 + 1)
            }

            k1 += 1;
            k2 += 1;
        }
    }
    moveto(0,30);
    printf("allocIndices[%g]actual_used[%g]",MAX_SPHERE_INDICES, num_indices);
     
    printf("\nvertCount[%g]num_verts[%g]",vertCount, num_verts);
     
    
    //vertexBuffer:[dynamic]vertex_format_t
    int cnt=0;
    glBeginMesh(0);
    glBegin(GL_TRIANGLES);
    for(i=0; i<num_indices; i+=1)
    {
        // vntc are all vec4, so we can send 16-floats to shader as attributes
        vec3 v = vertices[ indices[i] ];
        vec3 n = normals[ indices[i] ];
        vec2 t = texCoords[ indices[i] ];
        // Encode barycentric weights as color
        if (cnt==0) glColor(1,0,0,1);
        else if (cnt==1) glColor(0,1,0,1);
        else if (cnt==2) glColor(0,0,1,1);
        cnt++;
        cnt%=3;
        glNormal(n.x,n.y,n.z);
        glTexCoord(t.x,t.y);
        glVertex(v.x, v.y, v.z);
    }
    glEnd();
    glEndMesh();
    return 0;
}  

@v: =======================

varying vec4 v, c, t, p;
varying vec3 n;

uniform mat3 gl_NormalMatrix;

void main()
{
   v = gl_Vertex;
   c = gl_Color;
   t = gl_MultiTexCoord0;
   n = gl_NormalMatrix * gl_Normal;
   p = gl_ModelViewMatrix * v;
   gl_Position = gl_ProjectionMatrix * p;
}

@f: =======================

uniform sampler2D tex0;

varying vec4 v, c, t, p;
varying vec3 n;

void main()
{
   vec4 base = texture2D(tex0, t.xy+.125);
   vec3 light_pos = vec3(.25,1.0,2.0);
   vec3 light_dir = light_pos - p.xyz;
   float dist = dot(light_dir, light_dir);
   light_dir *= inversesqrt(dist);
   //vec3 norm = normalize(n);
   vec3 norm = vec3(0,0,1);
   float diffuse = max(0.0, dot(norm, light_dir))*(24.0/dist);
   float spec = max(0.0,dot(reflect(light_dir,norm),normalize(p.xyz)));
   spec = pow(spec, 16.0)*.25;
   //vec4 kolor = mix( c, vec4(1.0,1.0,1.0,1.0), .7 );
   
   vec4 kolor = vec4(1.0,1.0,1.0,1.0);
   gl_FragColor = base*kolor*diffuse + spec*vec4(1.0);
   
   if(c.x < 0.01 || c.y < 0.01 || c.z < 0.01) {
    gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
  } else {
    gl_FragColor = base*kolor*diffuse + spec*vec4(1.0);
  }
  /*
  if(c.x < 0.01 || c.y < 0.01 || c.z < 0.01) {
    gl_FragColor = base*kolor*diffuse + spec*vec4(1.0);
  } else {
    discard;
  }*/
}

