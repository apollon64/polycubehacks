#use glsl_math
//#option preserve_buffer 0

enum{MAX_PARTICLES=100}
static vec2 part[MAX_PARTICLES];
static vec2 vel[MAX_PARTICLES];
static vec2 acc[MAX_PARTICLES];
static float mass[MAX_PARTICLES];
static alive[MAX_PARTICLES];
static vec3 color[MAX_PARTICLES];

static omx,omy;
static num_alive;
()
{
cls(); // 2d drawing is a separate buffer
glClear ( );
gluOrtho2D (0,xres,yres,0);

//glAlphaEnable ( );
glsetshader(1);
gluniform1i("tex0", 0);
glcolor(.1, .1, .1, .1);
//gluOrtho2D (-1,1,-1,1);

glQuad(1.0);

glcapture(0,xres,yres);
gluOrtho2D(0,xres,yres,0);
glsetshader(0);
draw();
glColor(0,0,0,.5); glquad(.1); // darken
glcaptureend();

moveto(10,12);
setcol(255,255,255);
printf("num_alive:%g / %g", num_alive, MAX_PARTICLES);

vec2 mousevel = vec2(mousx,mousy) - vec2(omx,omy);
moveto(omx,omy);lineto(mousx,mousy);


if (numframes==0) init();

if (bstatus==2)
{
part[2] = vec2(omx,omy);
alive[2] = 1;
vel[2] = vec2(0,0);
color[2] = vec3(1,0,0);
}
/*
vel[2] = vec2(0,0);
mass[2] = 100;*/

for(i=0; i<2; i++)
  simUniverse();


time=klock();
static timespawn= 0;
if (bstatus==1 && timespawn < time)
{
   timespawn = time + 0.1;
   for(i=0; i<MAX_PARTICLES; i++)
   {
      if(alive[i]==0)
      {
        alive[i] = 1;
        mass[i] = 10;
        part[i] = vec2(mousx,mousy);
        vel[i] = vec2(0,0);//10*mousevel;
        acc[i] = vec2(0,0);
        color[i] = vec3(rnd,1,1);
        break;
      }
   }
}

omx = mousx;
omy = mousy;


}

draw()
{
   num_alive=0;
   for(i=0; i<MAX_PARTICLES; i++)
   {
      if (alive[i]==0) continue;
      num_alive++;
      
      glBegin(GL_POLYGON);
      r = .5*mass[i];
      vec3 c = color[i];
      glColor (c.x,c.y,c.z);
      
      for(j=0; j<16; j++)
      {
        a = j/15.0 * 2*3.14;
        if (i==0) glVertex(part[i].x, part[i].y);
        x = part[i].x + r*cos(a);
        y = part[i].y + r*sin(a);
        glVertex(x,y);
      }
      glEnd();
   }
}

simUniverse()
{
  
   dt = 0.005;
   for(i=0; i<MAX_PARTICLES; i++)
   {
     if (alive[i]==0) continue;
     vel[i] += dt * acc[i];  // v = a * dt
     if (length(vel[i]) > 1000) vel[i] = 1000*normalize(vel[i]);
     part[i] += vel[i] * dt; // p = v * dt
     acc[i] = vec2(0,0);
     // a = F/m
     
   }
   
   
   for(i=0; i<MAX_PARTICLES; i++)
   {
      if (alive[i]==0) continue;
      vec2 a = vec2(0,0);
      for(j=0; j<MAX_PARTICLES; j++)
      {
         if (alive[j]==0) continue;
         if (i==j) continue;
         vec2 d = part[j] - part[i];
         float lensq = fabs(dot(d,d));
         float msq = (mass[i])^2 + (mass[j])^2;
         if ( lensq < msq ) 
         { 
            veli = dot(vel[i],vel[i]);
            velj = dot(vel[j],vel[j]);
            if (veli*mass[i] > velj*mass[j])
            {
              alive[j]=0;
              mass[i] += .5*mass[j];
              vel[i] += vel[j]/mass[i];
              continue;
            } else {
               alive[i]=0;
               mass[j] += .5*mass[i];
               vel[j] += vel[i]/mass[j];
               break;
            }
            
         }
         // F = ma
         //a = F/m
         m = mass[i] + mass[j];
         force = (300000*m) / lensq;
         
         vec2 direction = normalize(d);
         // A = f/M
         a += direction * force / mass[i];
      }
     acc[i] = a;
   }

}

init(){
   vec2 center = vec2(xres/2, yres/2);
   r = 150;
   for(i=0; i<MAX_PARTICLES; i++)
   {
     part[i] = center + r*vec2(nrnd,nrnd);
     vel[i]=vec2(0,0);
     acc[i] = vec2(0,0);
     color[i] = vec3(1,1,1);
     mass[i] = 6;
     alive[i]=1;
   }
}


@v: // vertex shader start
varying vec4 p, c, t;
varying vec3 n;

void main()
{
   gl_Position = ftransform();
   c = gl_Color;
   p = gl_Position;
   n = gl_Normal;
   t = gl_MultiTexCoord0;
}
@f: // fragment shader start
//#version 300 es

varying vec4 p, c, t;
varying vec3 n;

uniform sampler2D tex0;

// All components are in the range [0…1], including hue.
vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void main()
{
   gl_FragColor.a = c.a;
   gl_FragColor.rgb=hsv2rgb(c.rgb);

}

@f: // fragment shader start
//#version 300 es

varying vec4 p, c, t;
varying vec3 n;

uniform sampler2D tex0;

void main()
{
   float z = c.r;
   float y = c.r/2.0 - 0.5;
   gl_FragColor = vec4(texture2D(tex0, vec2(t)));
   //gl_FragColor.a=0.4;

}

