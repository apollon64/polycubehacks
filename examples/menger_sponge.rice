// sponge() walks each of a cube's 6 faces as a
// 3x3 grid with the center point skipped (8 per face), recursing into a
// child cube at each of those points -- so it only actually draws once
// levels > 1, and starting the top call at levels=0 gives exactly two
// rounds of that 48-way subdivision (48 x 48 = 2304 drawn cubes, counted
// live by the on-screen number) before it bottoms out.
#use glsl_math

static iter, menger_verts, menger_tris;

static vec3 camPos;
static camHorizAngle;
static camVertiAngle;
()
{
   if (numframes == 0)
   {
      camPos = vec3(0, 0, -28);
      camHorizAngle = pi;// faces the sponge at the origin from here
      camVertiAngle = 0;
   }
   static otim;
   tim=klock(); dt=tim-otim; otim=tim;
   

   cls(0);
   glClear();
   glEnable(GL_DEPTH_TEST);
   glCullFace(GL_FRONT);
   glUniform1i("tex0", 0); // texture slot 0 (squares) is bound to unit 0 by default

   playercontrols();

   gluPerspective(60, xres/yres, 0.1, 1000.0);
   vec3 forward = vec3(-cos(camVertiAngle)*sin(camHorizAngle), sin(camVertiAngle), -cos(camVertiAngle)*cos(camHorizAngle));
   vec3 target = camPos + forward;
   gluLookAt(camPos.x, camPos.y, camPos.z, target.x, target.y, target.z, 0, 1, 0);

   // Bake static geometry into a mesh/display-list
   static sponge_handle = 0;
   if (numframes==0)
   {
     iter = 0;
     double rootSkip[6]; // root call never draws directly -- value unused
     glBeginMesh(sponge_handle);
       glBegin(GL_QUADS);
         sponge( vec3(0, 0, 0), 5.0, -1, rootSkip);
       glEnd();
     glEndMesh();
   }

   
/*
   vec3 lightRed, lightGreen, lightBlue, lightYellow, lightWhite;
   update_lights(lightRed, lightGreen, lightBlue, lightYellow, lightWhite);

   

   glBegin(GL_QUADS);
   draw_light_marker(lightRed,    vec3(1.0, 0.15, 0.15));
   draw_light_marker(lightGreen,  vec3(0.15, 1.0, 0.15));
   draw_light_marker(lightBlue,   vec3(0.25, 0.4, 1.0));
   draw_light_marker(lightYellow, vec3(1.0, 0.95, 0.2));
   draw_light_marker(lightWhite,  vec3(1.0, 1.0, 1.0));
   glEnd();
*/
   glMesh(sponge_handle);
   moveto(0, 0);
   setcol(255, 255, 255);
   printf("\n%g cubes %g verts %g tris", iter, menger_verts, menger_tris);
   printf("\n%dfps, %.3fmspf", int(1/dt), 1000*dt);
}

// playercontrols() drives camPos/camHorizAngle/camVertiAngle from
// WASD + mouse-drag look; the main loop turns that into the actual GL
// camera each frame via gluPerspective/gluLookAt.
playercontrols()
{
   static oldMouseX;
   static oldMouseY;

   f = 0.1;
   if (keystatus[0x2a]) f /= 4; // shift: slow
   if (keystatus[0x36]) f *= 4; // ctrl: fast
   vx = (keystatus[32] - keystatus[30]) * f; // D - A
   vy = (keystatus[17] - keystatus[31]) * f; // W - S

   // right/forward must match the gluLookAt forward vector in the main
   // loop (see the coordinate-system note at the top of this file) or
   // WASD would strafe/walk sideways relative to where the camera is
   // actually looking.
   rightX = cos(camHorizAngle);
   rightZ = -sin(camHorizAngle);
   forwardX = -cos(camVertiAngle) * sin(camHorizAngle);
   forwardY = sin(camVertiAngle);
   forwardZ = -cos(camVertiAngle) * cos(camHorizAngle);

   camPos.x += rightX * vx + forwardX * vy;
   camPos.y += forwardY * vy;
   camPos.z += rightZ * vx + forwardZ * vy;

   mouseSpeedX = (mousx - oldMouseX) * 0.01;
   mouseSpeedY = (mousy - oldMouseY) * 0.01;
   oldMouseX = mousx;
   oldMouseY = mousy;
   if (bstatus == 1)
   {
      camHorizAngle -= mouseSpeedX;
      camVertiAngle -= mouseSpeedY;
   }
}

// Given a face's unit normal p and 2D coords (u,v) within that face,
// writes the corresponding 3D point on the surface of a unit cube.
point_on_face(vec3 p, u, v, vec3 &vout)
{
   if (fabs(p.x)) { vout = vec3(p.x, u, v); return; }
   if (fabs(p.y)) { vout = vec3(u, p.y, v); return; }
   if (fabs(p.z)) { vout = vec3(u, v, p.z); return; }
}

// faceSkip tells which of the cubes 6 faces we can skip,
// because a same-parent-face sibling sits flush against it.
// order for face-skip mask: -X,+X,-Y,+Y,-Z,+Z.
sponge(vec3 pos, size, levels, faceSkip[6])
{
   if (levels > 1)
   {
      drawcube(pos, size * 1.5, faceSkip);
      iter++;
      return;
   }

   vec3 faces[6];
   faces[0] = vec3(1, 0, 0);
   faces[1] = vec3(-1, 0, 0);
   faces[2] = vec3(0, 1, 0);
   faces[3] = vec3(0, -1, 0);
   faces[4] = vec3(0, 0, 1);
   faces[5] = vec3(0, 0, -1);

   for (faceidx = 0; faceidx < 6; faceidx++)
   {
      for (i = 0; i < 3; i++)
      for (j = 0; j < 3; j++)
      {
         if (i == 1 && j == 1) continue; // face center: not part of the sponge

         u = -1 + i;
         v = -1 + j;

         vec3 pt;
         point_on_face(faces[faceidx], u, v, pt);

         // Does an existing (non-center) sibling sit at grid step
         // (di,dj) from (i,j) on this same parent face?
         hasNegU = (i > 0) && !(i-1 == 1 && j == 1);
         hasPosU = (i < 2) && !(i+1 == 1 && j == 1);
         hasNegV = (j > 0) && !(i == 1 && j-1 == 1);
         hasPosV = (j < 2) && !(i == 1 && j+1 == 1);

         double childSkip[6];
         if (fabs(faces[faceidx].x))
         {
            childSkip[2] = hasNegU; childSkip[3] = hasPosU; // -Y/+Y
            childSkip[4] = hasNegV; childSkip[5] = hasPosV; // -Z/+Z
         }
         else if (fabs(faces[faceidx].y))
         {
            childSkip[0] = hasNegU; childSkip[1] = hasPosU; // -X/+X
            childSkip[4] = hasNegV; childSkip[5] = hasPosV; // -Z/+Z
         }
         else
         {
            childSkip[0] = hasNegU; childSkip[1] = hasPosU; // -X/+X
            childSkip[2] = hasNegV; childSkip[3] = hasPosV; // -Y/+Y
         }

         sponge(pt * size + pos, size / 3, levels + 1, childSkip);
      }
   }
}

// faceSkip indices: 0=-X, 1=+X, 2=-Y, 3=+Y, 4=-Z, 5=+Z (see sponge()).
drawcube(vec3 pos, size, faceSkip[6])
{
   //r = 0; g = 0; b = 0;
   //hue_to_rgb(iter % 60, &r, &g, &b);
   vec3 n = +vec3(0.5) + (.5 * normalize(pos));

   glColor(n.x,n.y,n.z);

   x = pos.x; y = pos.y; z = pos.z;

   if (!faceSkip[4]) { // -Z
   glNormal(0,0,-1);
   glTexCoord(0,0); glVertex(x-size,y-size,z-size);
   glTexCoord(1,0); glVertex(x+size,y-size,z-size);
   glTexCoord(1,1); glVertex(x+size,y+size,z-size);
   glTexCoord(0,1); glVertex(x-size,y+size,z-size);
   menger_verts+=4;
   menger_tris+=2;
   }

   if (!faceSkip[0]) { // -X
   glNormal(-1,0,0);
   glTexCoord(0,0); glVertex(x-size,y-size,z+size);
   glTexCoord(1,0); glVertex(x-size,y-size,z-size);
   glTexCoord(1,1); glVertex(x-size,y+size,z-size);
   glTexCoord(0,1); glVertex(x-size,y+size,z+size);
   menger_verts+=4;
   menger_tris+=2;
   }

   if (!faceSkip[5]) { // +Z
   glNormal(0,0,1);
   glTexCoord(0,0); glVertex(x+size,y-size,z+size);
   glTexCoord(1,0); glVertex(x-size,y-size,z+size);
   glTexCoord(1,1); glVertex(x-size,y+size,z+size);
   glTexCoord(0,1); glVertex(x+size,y+size,z+size);
   menger_verts+=4;
   menger_tris+=2;
   }

   if (!faceSkip[1]) { // +X
   glNormal(1,0,0);
   glTexCoord(0,0); glVertex(x+size,y-size,z-size);
   glTexCoord(1,0); glVertex(x+size,y-size,z+size);
   glTexCoord(1,1); glVertex(x+size,y+size,z+size);
   glTexCoord(0,1); glVertex(x+size,y+size,z-size);
   menger_verts+=4;
   menger_tris+=2;
   }

   if (!faceSkip[2]) { // -Y
   glNormal(0,-1,0);
   glTexCoord(0,0); glVertex(x-size,y-size,z+size);
   glTexCoord(1,0); glVertex(x+size,y-size,z+size);
   glTexCoord(1,1); glVertex(x+size,y-size,z-size);
   glTexCoord(0,1); glVertex(x-size,y-size,z-size);
   menger_verts+=4;
   menger_tris+=2;
   }

   if (!faceSkip[3]) { // +Y
   glNormal(0,1,0);
   glTexCoord(0,0); glVertex(x-size,y+size,z-size);
   glTexCoord(1,0); glVertex(x+size,y+size,z-size);
   glTexCoord(1,1); glVertex(x+size,y+size,z+size);
   glTexCoord(0,1); glVertex(x-size,y+size,z+size);
   menger_verts+=4;
   menger_tris+=2;
   }
   
   
}

// expects h in [0,360), s and v in [0,1]; writes r,g,b in [0,1].
hue_to_rgb(h, &r, &g, &b)
{
   v = 1; s = 1;
   hf = h / 60.0;
   i = floor(hf);
   f = hf - i;
   pv = v * (1 - s);
   qv = v * (1 - s * f);
   tv = v * (1 - s * (1 - f));
   if (i == 0) { r = v; g = tv; b = pv; }
   if (i == 1) { r = qv; g = v; b = pv; }
   if (i == 2) { r = pv; g = v; b = tv; }
   if (i == 3) { r = pv; g = qv; b = v; }
   if (i == 4) { r = tv; g = pv; b = v; }
   if (i == 5) { r = v; g = pv; b = qv; }
   if (i == 6) { r = v; g = tv; b = pv; }
   if (i == -1) { r = v; g = tv; b = qv; }
}

// worldPos/worldNormal pass gl_Vertex/gl_Normal straight through with normal matrix
@v:
varying vec4 c;
varying vec2 t;
varying vec3 worldPos;
varying vec3 worldNormal;
void main () {
   gl_Position = ftransform();
   c = gl_Color;
   t = gl_MultiTexCoord0.xy;
   worldPos = gl_Vertex.xyz;
   worldNormal = gl_Normal;
}

@f:
uniform sampler2D tex0;
uniform vec3 lightPos0, lightPos1, lightPos2, lightPos3, lightPos4;
varying vec4 c;
varying vec2 t;
varying vec3 worldPos;
varying vec3 worldNormal;

vec3 pointLight(vec3 p, vec3 n, vec3 lp, vec3 lcol) {
   vec3 toLight = lp - p;
   float dist = length(toLight);
   vec3 dir = toLight / dist;
   float ndotl = max(dot(n, dir), 0.0);
   float atten = 1.0 / (1.0 + 0.04*dist + 0.012*dist*dist);
   return lcol * ndotl * atten;
}

void main () {
   vec3 n = normalize(worldNormal);
   vec3 lit = vec3(0.12); // ambient floor so unlit faces aren't pure black
   lit += pointLight(worldPos, n, lightPos0, vec3(1.0, 0.15, 0.15)); // RED
   lit += pointLight(worldPos, n, lightPos1, vec3(0.15, 1.0, 0.15)); // GREEN
   lit += pointLight(worldPos, n, lightPos2, vec3(0.25, 0.4, 1.0));  // BLUE
   lit += pointLight(worldPos, n, lightPos3, vec3(1.0, 0.95, 0.2));  // YELLOW
   lit += pointLight(worldPos, n, lightPos4, vec3(1.0, 1.0, 1.0));   // WHITE
   vec4 base = texture2D(tex0, t) * c;
   gl_FragColor = vec4(base.rgb * lit, base.a);
}



