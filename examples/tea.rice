#use glsl_math
()
{
  gluPerspective(60, xres/yres, 0.1, 1000.0);

  global_time = klock();

  glTranslate(0,0,-4);
  if (bstatus) {
     glRotate((mousy/yres-.5)*240,1,0,0);
     glRotate((mousx/xres-.5)*240,0,1,0);
  } else {
     glRotate(global_time*40,0,1,0);
     //glRotate(global_time*18,1,0,0);
  }
  glTranslate(0,-1,0);
  glRotate(-90,1,0,0);
  //glRotate(15,1,0,0);
  
  glUniform1i("tex0", 0);
  glColor(1,1,1);
  
  glCullFace(GL_BACK);
  glPushMatrix();
  glTranslate(0,0,-0.1);
  glScale(1.5, 1.5, .1);
  cube();
  glPopMatrix();
  
  glUniform1i("tex0", 1);
  glCullFace(GL_FRONT);
  draw_utah_teapot( vec3(0), vec3(0), vec3(.5) );
  
}

cube()
{
   glBegin(GL_QUADS);
      glNormal(0,1,0);
      glTexCoord(1.0, 0.0); glVertex( 1.0, 1.0,-1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0, 1.0,-1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0, 1.0, 1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0, 1.0, 1.0);
   
      glNormal(0,-1,0);
      glTexCoord(1.0, 0.0); glVertex( 1.0,-1.0, 1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0,-1.0, 1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0,-1.0,-1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0,-1.0,-1.0);

      glNormal(0,0,1);
      glTexCoord(1.0, 0.0); glVertex( 1.0, 1.0, 1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0, 1.0, 1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0,-1.0, 1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0,-1.0, 1.0);

      glNormal(0,0,-1);
      glTexCoord(1.0, 0.0); glVertex(1.0,-1.0,-1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0,-1.0,-1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0, 1.0,-1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0, 1.0,-1.0);

      glNormal(-1,0,0);
      glTexCoord(1.0, 0.0); glVertex(-1.0, 1.0, 1.0);
      glTexCoord(1.0, 1.0); glVertex(-1.0, 1.0,-1.0);
      glTexCoord(0.0, 1.0); glVertex(-1.0,-1.0,-1.0);
      glTexCoord(0.0, 0.0); glVertex(-1.0,-1.0, 1.0);

      glNormal(1,0,0);
      glTexCoord(1.0, 0.0); glVertex( 1.0, 1.0,-1.0);
      glTexCoord(1.0, 1.0); glVertex( 1.0, 1.0, 1.0);
      glTexCoord(0.0, 1.0); glVertex( 1.0,-1.0, 1.0);
      glTexCoord(0.0, 0.0); glVertex( 1.0,-1.0,-1.0);
   glEnd();
}

glVertex3(vec4 v) {
  glVertex(v.x,v.y,v.z);
}

drawTriangle3Dold(vec4 verts[3], vec4 attrs[3]) {
  glBegin(GL_TRIANGLES);
    glTexCoord(0,0);
    glVertex3(verts[0]);
    glTexCoord(1,0);
    glVertex3(verts[1]);
    glTexCoord(0,1);
    glVertex3(verts[2]);
  glEnd();
}
drawTriangle3D(vec4 verts[3], vec4 tc[3], vec3 normal) {
  glBegin(GL_TRIANGLES);
    glNormal(normal.x, normal.y, normal.z);
    glTexCoord(tc[0].x, tc[0].y); glVertex3(verts[0]);
    glTexCoord(tc[1].x, tc[1].y); glVertex3(verts[1]);
    glTexCoord(tc[2].x, tc[2].y); glVertex3(verts[2]);
  glEnd();
}


