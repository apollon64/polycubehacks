vec4 bezier_patch_eval(vec4 cp[4][4], float u, float v) {
  

    float bu[4] = { (1.-u)*(1.-u)*(1.-u), 3*u*(1.-u)*(1.-u), 3*u*u*(1.-u), u*u*u };
    float bv[4] = { (1.-v)*(1.-v)*(1.-v), 3*v*(1.-v)*(1.-v), 3*v*v*(1.-v), v*v*v };
    vec4 p = vec4(0.);
    for (int i=0; i<4; i++)
        for (int j=0; j<4; j++)
            p += bu[i] * bv[j] * cp[i][j];
    return p;
}

draw_utah_teapot(vec3 position, vec3 rotation, vec3 scale) {
    mat4 model;
    identity(model);
    translate(model, position);
    rotate(model, rotation.x, vec3(1,0,0));
    rotate(model, rotation.y, vec3(0,1,0));
    rotate(model, rotation.z, vec3(0,0,1));
    scale(model, scale);
    //mat4 mvp;
    //mvp = model;
    //mvp = getModelView(settings3D.znear, settings3D.zfar) * model;


    int tess = 8; // Increased to 8 or 16 for better faceting detail
    float step = 1.0 / tess;

    // Lighting setup
    vec3 lightDir = normalize(vec3(0.5, 0.8, 0.6)); // Directional light
    vec3 baseColor = vec3(0.8, 0.8, 0.8); // Silver

    for (int p = 0; p < 32; p++) {
       vec4 cp[4][4];
       for (int i=0; i<4; i++) {
           for (int j=0; j<4; j++) {
               // Get the index directly from the patch map (0 to 305)
               int patchtIdx = teapot_patches[p][(4*i+j) ]-1; 
               // Use the 1D array
               cp[i][j] = vec4(teapot_vertices[patchtIdx],1.0);
               
           }
       }

        for (int i=0; i<tess; i++) {
            float u0 = i * step;
            float u1 = (i+1) * step;
            for (int j=0; j<tess; j++) {
                float v0 = j * step;
                float v1 = (j+1) * step;

                vec4 p00 = bezier_patch_eval(cp, u0, v0);
                vec4 p10 = bezier_patch_eval(cp, u1, v0);
                vec4 p01 = bezier_patch_eval(cp, u0, v1);
                vec4 p11 = bezier_patch_eval(cp, u1, v1);

                // Transform to World Space (for normals)
                vec4 world00 = model * p00;
                vec4 world10 = model * p10;
                vec4 world01 = model * p01;
                vec4 world11 = model * p11;

                // Transform to Clip Space (for rendering)
                //vec4 clip[4];
                //clip[0] = mvp * p00;
                //clip[1] = mvp * p10;
                //clip[2] = mvp * p01;
                //clip[3] = mvp * p11;
                
                vec4 texCoords[4];
                texCoords[0] = vec4(1-u0, v0,0,0);
                texCoords[1] = vec4(1-u1, v0,0,0);
                texCoords[2] = vec4(1-u0, v1,0,0);
                texCoords[3] = vec4(1-u1, v1,0,0);

                vec4 verts[3], attrs[3], attr_tc[3];
                // --- Triangle 1: 0, 1, 2 ---
                // Original correct order (Counter-Clockwise)
                vec3 e1 = vec3(world10 - world00);
                vec3 e2 = vec3(world01 - world00);
                vec3 n = normalize(cross(e1, e2)); // Points OUTWARD

                float diff = max(dot(n, lightDir), 0.0);
                vec3 litColor = baseColor * (0.2 + 0.8 * diff);
                vec4 faceColor = vec4(litColor, 1.0);

                //verts[0] = clip[0]; verts[1] = clip[1]; verts[2] = clip[2];
                verts[0] = world00; verts[1] = world10; verts[2] = world01;
                attrs[0] = attrs[1] = attrs[2] = faceColor;
                attr_tc[0] = texCoords[0]; attr_tc[1] = texCoords[1]; attr_tc[2] = texCoords[2];
                drawTriangle3D(verts, attr_tc, -n);

                // --- Triangle 2: 1, 3, 2 ---
                vec3 e1_2 = vec3(world11 - world10);
                vec3 e2_2 = vec3(world01 - world10);
                vec3 n_2 = normalize(cross(e1_2, e2_2)); // Points OUTWARD

                float diff_2 = max(dot(n_2, lightDir), 0.0);
                vec3 litColor_2 = baseColor * (0.2 + 0.8 * diff_2);
                vec4 faceColor_2 = vec4(litColor_2, 1.0);

                //verts[0] = clip[1]; verts[1] = clip[3]; verts[2] = clip[2];
                verts[0] = world10; verts[1] = world11; verts[2] = world01;
                attrs[0] = attrs[1] = attrs[2] = faceColor_2;
                attr_tc[0] = texCoords[1]; attr_tc[1] = texCoords[3]; attr_tc[2] = texCoords[2];
                drawTriangle3D(verts, attr_tc, -n);
                
            } // tess j
        } // tess i
    } // cp
}

@v: =======================

varying vec4 v, c, t, p;
varying vec3 n;

uniform mat3 gl_NormalMatrix;

void main()
{
   v = gl_Vertex;
   c = gl_Color;
   t = gl_MultiTexCoord0;
   n = gl_NormalMatrix * gl_Normal;
   p = gl_ModelViewMatrix * v;
   gl_Position = gl_ProjectionMatrix * p;
}

@f: =======================

uniform sampler2D tex0;

varying vec4 v, c, t, p;
varying vec3 n;

void main()
{
   vec4 base = texture2D(tex0, t.xy);
   vec3 light_pos = vec3(.25,1.0,2.0);
   vec3 light_dir = light_pos - p.xyz;
   float dist = dot(light_dir, light_dir);
   light_dir *= inversesqrt(dist);
   vec3 norm = normalize(n);
   float diffuse = max(0.0, dot(norm, light_dir)); //*(24.0/dist);
   float spec = max(0.0,dot(reflect(light_dir,norm),normalize(p.xyz)));
   spec = pow(spec, 16.0)*.25;
   gl_FragColor = base*c*diffuse + spec*vec4(1.0);
}
